# ============================================================
#  Configuration de l'agent Ben&Fit
#  Remplis les lignes ci-dessous, enregistre, puis lance start.bat
#  Ne partage jamais ce fichier : il contient tes clés secrètes.
# ============================================================

# --- OBLIGATOIRE ---------------------------------------------

# Connexion à ton abonnement Claude (0 € en plus).
# Rempli automatiquement par connexion_claude.bat
CLAUDE_CODE_OAUTH_TOKEN=

# Token du bot Telegram, donné par @BotFather (commande /newbot)
TELEGRAM_BOT_TOKEN=

# Ton identifiant Telegram (seul toi pourras parler à l'agent).
# Laisse vide au début : écris au bot, il te répondra ton identifiant.
ALLOWED_USER_IDS=

# --- RÉGLAGES (optionnel) ------------------------------------

# Plus tard, pour passer en clé API payante à l'usage (sans toucher au quota
# de ton abonnement) : remplis la clé et mets AUTH_MODE=api
AUTH_MODE=abonnement
ANTHROPIC_API_KEY=

OWNER_NAME=Bene
# Nom de ton assistant
ASSISTANT_NAME=Jarvis
TIMEZONE=Europe/Paris
# claude-sonnet-5-5 = bon équilibre ; claude-haiku-5-5 = consomme moins de quota ; claude-opus-5-5 = le plus fort
MODEL=claude-sonnet-5-5
# Modèles par usage (vide = MODEL). Ex. MODEL_COACH=claude-sonnet-5-5 pour /reponse
MODEL_BRIEF=
MODEL_COACH=
MAX_TOKENS=4096
# Nombre de messages gardés en contexte
HISTORY_LENGTH=20
# Recherche web (true/false)
WEB_SEARCH=true

# --- BRIEF DU MATIN & AGENDA -----------------------------------
# Heure du brief quotidien (HH:MM). Laisse vide pour le désactiver.
BRIEF_TIME=07:30
# Format du brief automatique : texte, vocal ou les deux
BRIEF_FORMAT=texte
# Voix des notes vocales (féminine). Autres : fr-FR-VivienneMultilingualNeural, fr-FR-EloiseNeural
TTS_VOICE=fr-FR-DeniseNeural
TTS_RATE=+5%
# Autoriser la lecture vocale de textes contenant des données clients (service Microsoft externe)
TTS_CLIENT_DATA=false
# Si le PC était éteint à l'heure du brief, il part au démarrage jusqu'à cette heure
BRIEF_CATCHUP_UNTIL=12:00
# Récap des bilans du week-end (format cron, heure de Paris). Vide = désactivé.
# Défaut : lundi 20h. Ex. mardi 8h : 0 8 * * tue
BILANS_CRON=0 20 * * mon

# Tes agendas, en lecture seule, via leur lien iCal secret (voir README).
# Format : Nom=lien, Nom2=lien2
# ex. CALENDARS=Perso=https://calendar.google.com/calendar/ical/.../basic.ics
CALENDARS=

# --- VOIX ------------------------------------------------------
# Tes vocaux Telegram sont transcrits SUR TA MACHINE (rien n'est envoyé dehors).
# Modèle : tiny, base, small (défaut, bon en français), medium (plus précis, plus lent)
STT_MODEL=small
# Quand tu m'envoies un vocal, je réponds en : voix, texte ou les deux
VOICE_REPLY=les deux

# --- MAILS (Gmail) ---------------------------------------------
# Lecture + envoi APRÈS ton /ok. Mot de passe d'application : voir README (section Jarvis).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Bene
# Signature ajoutée en bas des mails (\n pour un retour à la ligne)
MAIL_SIGNATURE=

# --- MAISON (Home Assistant) ------------------------------------
# Adresse locale, ex. http://homeassistant.local:8123
HA_URL=
# Profil Home Assistant > Sécurité > Jetons d'accès longue durée > Créer un jeton
HA_TOKEN=
# Enceinte par défaut pour les annonces (ex. assist_satellite.home_assistant_voice_xxxx)
HA_SATELLITE=
# Ce que Jarvis peut faire quand on lui parle par l'enceinte (n'importe qui à la maison)
HOME_VOICE_TOOLS=home_status,home_control,agenda_events,todo_list,todo_add,birthday_list
# Recopier sur Telegram les questions posées à l'enceinte
HOME_TRACE=true

# --- COMPÉTENCE COACHING : dashboard Ben-Fit (lecture seule) ---
# Les mêmes valeurs que ton app Ben-Fit. Deux endroits pour les trouver :
#  - Supabase > ton projet > Project Settings > API (et API Keys)
#  - ou Vercel > projet ben-and-fit > Settings > Environment Variables
#    (NEXT_PUBLIC_SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY)
# URL du projet, ex. https://abcdefgh.supabase.co
SUPABASE_URL=
# Clé "service_role" (secrète ! elle voit toutes les données)
SUPABASE_SERVICE_KEY=

# --- COMPÉTENCE DEV : GitHub ---------------------------------
# github.com > Settings > Developer settings > Personal access tokens > Fine-grained
# Droits : Contents (read/write), Issues (read/write), Pull requests (read/write)
GITHUB_TOKEN=
GITHUB_OWNER=Bene72
